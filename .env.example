# ─── NEXUS Universal Environment File ─────────────────────────────────────────
# Shared by both /backend (FastAPI) and /frontend (Next.js).
# Copy this file to /.env and fill in your real values.
# DO NOT commit /.env — it is gitignored.

# ── MongoDB (Atlas free tier) ─────────────────────────────────────────────────
MONGODB_URI=

# ── External APIs ─────────────────────────────────────────────────────────────
INDIAN_KANOON_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# ── Frontend → Backend URL (NEXT_PUBLIC_ prefix required for browser exposure) ─
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
